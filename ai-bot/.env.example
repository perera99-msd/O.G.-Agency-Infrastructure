# Port configuration
PORT=4000

# CORS Allowed Origin (e.g. Next.js website URL)
ALLOWED_ORIGIN=http://localhost:3000

# Google Gemini API Key (Required for text-embedding-004 and primary LLM generation)
# Obtain at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key (Required for fast fallback LLM generation)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=
